{
    "openapi": "3.0.0",
    "info": {
        "title": "TechHire API",
        "version": "1.0.0",
        "description": "API documentation for the TechHire equipment booking platform"
    },
    "servers": [
        {
            "url": "http://localhost:4000",
            "description": "Local development server"
        }
    ],
    "paths": {
        "/api/equipment": {
            "get": {
                "summary": "Get all equipment",
                "responses": {
                    "200": {
                        "description": "Successful response"
                    }
                }
            },
            "post": {
                "summary": "Create equipment",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Equipment"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Equipment created"
                    }
                }
            }
        },
        "/api/equipment/{id}": {
            "get": {
                "summary": "Get equipment by ID",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/IdParam"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Equipment found"
                    },
                    "404": {
                        "description": "Equipment not found"
                    }
                }
            },
            "put": {
                "summary": "Update equipment by ID",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/IdParam"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Equipment"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Equipment updated"
                    }
                }
            },
            "delete": {
                "summary": "Delete equipment by ID",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/IdParam"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Equipment deleted"
                    }
                }
            }
        },
        "/api/bookings": {
            "get": {
                "summary": "Get all bookings",
                "responses": {
                    "200": {
                        "description": "Successful response"
                    }
                }
            },
            "post": {
                "summary": "Create booking",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Booking"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Booking created"
                    }
                }
            }
        },
        "/api/bookings/{id}": {
            "put": {
                "summary": "Update booking by ID",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/IdParam"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Booking"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Booking updated"
                    }
                }
            },
            "delete": {
                "summary": "Delete booking by ID",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/IdParam"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Booking deleted"
                    }
                }
            }
        },
        "/api/payments": {
            "get": {
                "summary": "Get all payments",
                "responses": {
                    "200": {
                        "description": "Successful response"
                    }
                }
            },
            "post": {
                "summary": "Create payment",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Payment"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Payment created"
                    }
                }
            }
        },
        "/api/payments/{id}": {
            "get": {
                "summary": "Get payment by ID",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/IdParam"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Payment found"
                    },
                    "404": {
                        "description": "Payment not found"
                    }
                }
            },
            "put": {
                "summary": "Update payment by ID",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/IdParam"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Payment"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Payment updated"
                    }
                }
            },
            "delete": {
                "summary": "Delete payment by ID",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/IdParam"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Payment deleted"
                    }
                }
            }
        },
        "/api/reviews": {
            "get": {
                "summary": "Get all reviews",
                "responses": {
                    "200": {
                        "description": "Successful response"
                    }
                }
            },
            "post": {
                "summary": "Create review",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Review"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Review created"
                    }
                }
            }
        },
        "/api/reviews/{id}": {
            "get": {
                "summary": "Get review by ID",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/IdParam"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Review found"
                    },
                    "404": {
                        "description": "Review not found"
                    }
                }
            },
            "put": {
                "summary": "Update review by ID",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/IdParam"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Review"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Review updated"
                    }
                }
            },
            "delete": {
                "summary": "Delete review by ID",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/IdParam"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Review deleted"
                    }
                }
            }
        }
    },
    "components": {
        "parameters": {
            "IdParam": {
                "name": "id",
                "in": "path",
                "required": true,
                "description": "Unique resource identifier",
                "schema": {
                    "type": "string"
                }
            }
        },
        "schemas": {
            "Equipment": {
                "type": "object",
                "required": [
                    "name",
                    "category",
                    "pricePerDay"
                ],
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "category": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "pricePerDay": {
                        "type": "number"
                    },
                    "available": {
                        "type": "boolean",
                        "default": true
                    }
                }
            },
            "Booking": {
                "type": "object",
                "required": [
                    "customerName",
                    "equipment",
                    "startDate",
                    "endDate"
                ],
                "properties": {
                    "customerName": {
                        "type": "string"
                    },
                    "equipment": {
                        "type": "string",
                        "description": "Equipment ObjectId"
                    },
                    "startDate": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "endDate": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "status": {
                        "type": "string",
                        "default": "Pending"
                    }
                }
            },
            "Payment": {
                "type": "object",
                "required": [
                    "bookingId",
                    "userId",
                    "amount",
                    "paymentMethod",
                    "transactionId"
                ],
                "properties": {
                    "bookingId": {
                        "type": "string",
                        "description": "Booking ObjectId"
                    },
                    "userId": {
                        "type": "string",
                        "description": "User ObjectId"
                    },
                    "amount": {
                        "type": "number"
                    },
                    "paymentMethod": {
                        "type": "string",
                        "enum": [
                            "mobile_money",
                            "card",
                            "cash"
                        ]
                    },
                    "paymentStatus": {
                        "type": "string",
                        "enum": [
                            "pending",
                            "completed",
                            "failed",
                            "refunded"
                        ],
                        "default": "pending"
                    },
                    "transactionId": {
                        "type": "string"
                    }
                }
            },
            "Review": {
                "type": "object",
                "required": [
                    "userId",
                    "equipmentId",
                    "rating",
                    "comment"
                ],
                "properties": {
                    "userId": {
                        "type": "string",
                        "description": "User ObjectId"
                    },
                    "equipmentId": {
                        "type": "string",
                        "description": "Equipment ObjectId"
                    },
                    "rating": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 5
                    },
                    "comment": {
                        "type": "string"
                    }
                }
            }
        }
    }
}